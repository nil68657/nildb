[
  {"name": "$push appends",
   "doc": {"_id": 1, "a": [1]}, "update": {"$push": {"a": 2}},
   "result": {"_id": 1, "a": [1, 2]}},

  {"name": "$push creates the array",
   "doc": {"_id": 1}, "update": {"$push": {"a": 1}},
   "result": {"_id": 1, "a": [1]}},

  {"name": "$push an array adds it as one element",
   "doc": {"_id": 1, "a": [1]}, "update": {"$push": {"a": [2, 3]}},
   "result": {"_id": 1, "a": [1, [2, 3]]}},

  {"name": "$push onto a non-array fails",
   "doc": {"_id": 1, "a": 1}, "update": {"$push": {"a": 2}},
   "error": "ERR The field 'a' must be an array but is of type int in document {_id: 1}"},

  {"name": "$push $each",
   "doc": {"_id": 1, "a": [1]}, "update": {"$push": {"a": {"$each": [2, 3]}}},
   "result": {"_id": 1, "a": [1, 2, 3]}},

  {"name": "$push $each with $position",
   "doc": {"_id": 1, "a": [1, 2, 3]}, "update": {"$push": {"a": {"$each": [9], "$position": 1}}},
   "result": {"_id": 1, "a": [1, 9, 2, 3]}},

  {"name": "$push with a negative $position counts from the end",
   "doc": {"_id": 1, "a": [1, 2, 3]}, "update": {"$push": {"a": {"$each": [9], "$position": -1}}},
   "result": {"_id": 1, "a": [1, 2, 9, 3]}},

  {"name": "$push with $position past the end appends",
   "doc": {"_id": 1, "a": [1]}, "update": {"$push": {"a": {"$each": [9], "$position": 10}}},
   "result": {"_id": 1, "a": [1, 9]}},

  {"name": "$push with a positive $slice keeps the front",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$push": {"a": {"$each": [3, 4], "$slice": 3}}},
   "result": {"_id": 1, "a": [1, 2, 3]}},

  {"name": "$push with a negative $slice keeps the back",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$push": {"a": {"$each": [3, 4], "$slice": -2}}},
   "result": {"_id": 1, "a": [3, 4]}},

  {"name": "$push with $slice 0 empties the array",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$push": {"a": {"$each": [3], "$slice": 0}}},
   "result": {"_id": 1, "a": []}},

  {"name": "$push with $sort ascending",
   "doc": {"_id": 1, "a": [3, 1]}, "update": {"$push": {"a": {"$each": [2], "$sort": 1}}},
   "result": {"_id": 1, "a": [1, 2, 3]}},

  {"name": "$push with $sort descending across types",
   "doc": {"_id": 1, "a": ["b", 1]}, "update": {"$push": {"a": {"$each": [null], "$sort": -1}}},
   "result": {"_id": 1, "a": ["b", 1, null]}},

  {"name": "$push sorts by a field then slices",
   "doc": {"_id": 1, "a": [{"s": 5}, {"s": 1}]}, "update": {"$push": {"a": {"$each": [{"s": 3}], "$sort": {"s": -1}, "$slice": 2}}},
   "result": {"_id": 1, "a": [{"s": 5}, {"s": 3}]}},

  {"name": "$push with an empty $each creates an empty array",
   "doc": {"_id": 1}, "update": {"$push": {"a": {"$each": []}}},
   "result": {"_id": 1, "a": []}},

  {"name": "$push $each must be an array",
   "doc": {"_id": 1}, "update": {"$push": {"a": {"$each": 5}}},
   "error": "ERR The argument to $each in $push must be an array but it was of type: int"},

  {"name": "$push with an unknown clause",
   "doc": {"_id": 1}, "update": {"$push": {"a": {"$each": [1], "$foo": 1}}},
   "error": "ERR Unrecognized clause in $push: $foo"},

  {"name": "$push with a bad $sort",
   "doc": {"_id": 1}, "update": {"$push": {"a": {"$each": [1], "$sort": 2}}},
   "error": "ERR The $sort is invalid"},

  {"name": "$push with a fractional $slice",
   "doc": {"_id": 1}, "update": {"$push": {"a": {"$each": [1], "$slice": 1.5}}},
   "error": "ERR The value for $slice must be an integer value but was given type: double"},

  {"name": "$addToSet adds a new value",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$addToSet": {"a": 3}},
   "result": {"_id": 1, "a": [1, 2, 3]}},

  {"name": "$addToSet of a present value is a no-op",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$addToSet": {"a": 2}},
   "result": {"_id": 1, "a": [1, 2]}, "modified": false},

  {"name": "$addToSet treats equal numbers as present",
   "doc": {"_id": 1, "a": [1]}, "update": {"$addToSet": {"a": 1.0}},
   "result": {"_id": 1, "a": [1]}, "modified": false},

  {"name": "$addToSet $each skips present and repeated values",
   "doc": {"_id": 1, "a": [1]}, "update": {"$addToSet": {"a": {"$each": [1, 2, 2, 3]}}},
   "result": {"_id": 1, "a": [1, 2, 3]}},

  {"name": "$addToSet compares documents with field order",
