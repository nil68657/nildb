   "result": {"_id": 1, "a": [{"x": 1, "y": 2}, {"y": 2, "x": 1}]}},

  {"name": "$addToSet creates the array",
   "doc": {"_id": 1}, "update": {"$addToSet": {"a": 5}},
   "result": {"_id": 1, "a": [5]}},

  {"name": "$addToSet on a non-array fails",
   "doc": {"_id": 1, "a": 1}, "update": {"$addToSet": {"a": 2}},
   "error": "ERR Cannot apply $addToSet to non-array field. Field named 'a' has non-array type int"},

  {"name": "$pop 1 removes the last element",
   "doc": {"_id": 1, "a": [1, 2, 3]}, "update": {"$pop": {"a": 1}},
   "result": {"_id": 1, "a": [1, 2]}},

  {"name": "$pop -1 removes the first element",
   "doc": {"_id": 1, "a": [1, 2, 3]}, "update": {"$pop": {"a": -1}},
   "result": {"_id": 1, "a": [2, 3]}},

  {"name": "$pop an empty array is a no-op",
   "doc": {"_id": 1, "a": []}, "update": {"$pop": {"a": 1}},
   "result": {"_id": 1, "a": []}, "modified": false},

  {"name": "$pop a missing field is a no-op",
   "doc": {"_id": 1}, "update": {"$pop": {"a": 1}},
   "result": {"_id": 1}, "modified": false},

  {"name": "$pop takes only 1 or -1",
   "doc": {"_id": 1}, "update": {"$pop": {"a": 2}},
   "error": "ERR $pop expects 1 or -1, found: 2"},

  {"name": "$pop on a non-array fails",
   "doc": {"_id": 1, "a": 1}, "update": {"$pop": {"a": 1}},
   "error": "ERR Path 'a' contains an element of non-array type 'int'"},

  {"name": "$pull removes equal values",
   "doc": {"_id": 1, "a": [1, 2, 1, 3]}, "update": {"$pull": {"a": 1}},
   "result": {"_id": 1, "a": [2, 3]}},

  {"name": "$pull with a condition",
   "doc": {"_id": 1, "a": [1, 5, 8]}, "update": {"$pull": {"a": {"$gte": 5}}},
   "result": {"_id": 1, "a": [1]}},

  {"name": "$pull applies a query to each element document",
   "doc": {"_id": 1, "results": [{"item": "A", "score": 5}, {"item": "B", "score": 8, "comment": "x"}]},
   "update": {"$pull": {"results": {"score": 8, "item": "B"}}},
   "result": {"_id": 1, "results": [{"item": "A", "score": 5}]}},

  {"name": "$pull with $in",
   "doc": {"_id": 1, "a": ["a", "b", "c"]}, "update": {"$pull": {"a": {"$in": ["a", "c"]}}},
   "result": {"_id": 1, "a": ["b"]}},

  {"name": "$pull with a regex",
   "doc": {"_id": 1, "a": ["apple", "banana"]}, "update": {"$pull": {"a": {"$regularExpression": {"pattern": "^a", "options": ""}}}},
   "result": {"_id": 1, "a": ["banana"]}},

  {"name": "$pull that removes nothing is a no-op",
   "doc": {"_id": 1, "a": [1, 2]}, "update": {"$pull": {"a": 9}},
   "result": {"_id": 1, "a": [1, 2]}, "modified": false},

  {"name": "$pull on a non-array fails",
   "doc": {"_id": 1, "a": 1}, "update": {"$pull": {"a": 1}},
   "error": "ERR Cannot apply $pull to a non-array value"},

  {"name": "$pull an array value removes equal arrays",
   "doc": {"_id": 1, "a": [[1, 2], [3]]}, "update": {"$pull": {"a": [1, 2]}},
   "result": {"_id": 1, "a": [[3]]}},

  {"name": "$pull with $elemMatch inside an element query",
   "doc": {"_id": 1, "a": [{"b": [1, 2]}, {"b": [3]}]}, "update": {"$pull": {"a": {"b": {"$elemMatch": {"$eq": 3}}}}},
   "result": {"_id": 1, "a": [{"b": [1, 2]}]}},

  {"name": "$pull with $or over element documents",
   "doc": {"_id": 1, "a": [{"x": 1}, {"y": 2}, {"z": 3}]}, "update": {"$pull": {"a": {"$or": [{"x": 1}, {"y": 2}]}}},
   "result": {"_id": 1, "a": [{"z": 3}]}},

  {"name": "$pullAll",
   "doc": {"_id": 1, "a": [1, 2, 3, 1]}, "update": {"$pullAll": {"a": [1, 3]}},
   "result": {"_id": 1, "a": [2]}},

  {"name": "$pullAll needs an array",
   "doc": {"_id": 1}, "update": {"$pullAll": {"a": 1}},
   "error": "ERR $pullAll requires an array argument but was given a int"}
